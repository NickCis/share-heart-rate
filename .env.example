# Vercel (web + API)
PUBLIC_BASE_URL=https://share-heart-rate.vercel.app

# Firebase Admin SDK — JSON service account key (single line) for Firestore writes from /api
# Create in Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=share-heart-rate

# Firebase web client — see web/.env.example
