{
  "name": "share-heart-rate",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix web",
    "build:web": "npm run build --prefix web",
    "deploy": "vercel deploy --prod",
    "deploy:rules": "npx firebase deploy --only firestore:rules,firestore:indexes",
    "dev:vercel": "vercel dev",
    "dev:web": "npm run dev --prefix web",
    "emulators": "npx firebase emulators:start --only firestore",
    "garmin:build": "make -C garmin build",
    "garmin:run": "make -C garmin run",
    "garmin:simulator": "make -C garmin simulator"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vercel/edge": "^1.3.1",
    "@vercel/node": "^5.3.0",
    "firebase-tools": "^14.12.0",
    "typescript": "^5.9.2",
    "vercel": "^55.0.0"
  }
}
